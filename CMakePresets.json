{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (Ninja, compilador por defecto)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja, compilador por defecto)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "sanitize",
      "displayName": "ASan + UBSan (Ninja, GCC o Clang)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": { "ICPU_SANITIZE": "ON" }
    },
    {
      "name": "msvc-release",
      "displayName": "Release (Ninja + MSVC; requiere vcvars64)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/msvc-release",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "msvc-debug",
      "displayName": "Debug (Ninja + MSVC; requiere vcvars64)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/msvc-debug",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "msvc-debug", "configurePreset": "msvc-debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "sanitize", "configurePreset": "sanitize", "output": { "outputOnFailure": true } },
    { "name": "msvc-release", "configurePreset": "msvc-release", "output": { "outputOnFailure": true } },
    { "name": "msvc-debug", "configurePreset": "msvc-debug", "output": { "outputOnFailure": true } }
  ]
}
